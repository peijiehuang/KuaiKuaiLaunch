<ui:FluentWindow x:Class="KuaiKuaiLaunch.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:KuaiKuaiLaunch.ViewModels"
                 xmlns:ctrl="clr-namespace:KuaiKuaiLaunch.Views.Controls"
                 xmlns:conv="clr-namespace:KuaiKuaiLaunch.Converters"
                 mc:Ignorable="d"
                 Title="快快启动" 
                 Height="680" Width="530"
                 MinWidth="380" MinHeight="420"
                 ResizeMode="CanResize"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 AllowDrop="True"
                 Drop="OnWindowDrop"
                 DragOver="OnWindowDragOver">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar: Native OS Dragging across entire header -->
        <ui:TitleBar Grid.Row="0"
                     Title="快快启动"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False"
                     Padding="8,4,8,4"
                     MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <!-- Left Branding Header -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="6,0,0,0"
                            Background="Transparent"
                            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" IsHitTestVisible="False" />
                    <TextBlock Text="快快启动" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="Fluent" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>

            <!-- Right Window Actions -->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Pin / Always on Top Toggle Button -->
                    <ui:Button Appearance="Transparent" 
                               Padding="6" Margin="0,0,2,0" 
                               ToolTip="{Binding IsAlwaysOnTop, Converter={x:Static conv:BooleanToPinTooltipConverter.Instance}}"
                               Command="{Binding ToggleAlwaysOnTopCommand}">
                        <ui:SymbolIcon Symbol="{Binding IsAlwaysOnTop, Converter={x:Static conv:BooleanToPinSymbolConverter.Instance}}" 
                                       Foreground="{Binding IsAlwaysOnTop, Converter={x:Static conv:BooleanToPinBrushConverter.Instance}}"
                                       FontSize="15" />
                    </ui:Button>

                    <!-- Settings Button -->
                    <ui:Button Appearance="Transparent" 
                               Padding="6" Margin="0,0,2,0" 
                               ToolTip="软件设置"
                               Command="{Binding OpenSettingsCommand}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                    </ui:Button>

                    <!-- Minimize to Tray Button -->
                    <ui:Button Appearance="Transparent" 
                               Padding="6" Margin="0,0,2,0" 
                               ToolTip="最小化至系统托盘"
                               Click="OnMinimizeToTrayClick">
                        <ui:SymbolIcon Symbol="Subtract24" FontSize="15" />
                    </ui:Button>

                    <!-- Close to Tray Button -->
                    <ui:Button Appearance="Transparent" 
                               Padding="6" 
                               ToolTip="关闭并驻留托盘"
                               Click="OnCloseToTrayClick">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Body: Sidebar Categories + Content Groups -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Category Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="4,8"
                    MouseLeftButtonDown="OnSidebarMouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Category Items List with Modern Fluent ItemContainerStyle -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Margin" Value="2,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="BackgroundBorder" 
                                                        CornerRadius="6" 
                                                        Background="Transparent" 
                                                        SnapsToDevicePixels="True" 
                                                        Margin="2,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="IndicatorPill" 
                                                        Width="3.5" Height="18" 
                                                        CornerRadius="2" 
                                                        HorizontalAlignment="Left" 
                                                        VerticalAlignment="Center" 
                                                        Margin="2,0,0,0" 
                                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                        Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    <Setter TargetName="IndicatorPill" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                <Border Margin="2,4" 
                                        CornerRadius="6"
                                        Padding="4"
                                        Background="Transparent"
                                        AllowDrop="True"
                                        Drop="OnCategoryDrop"
                                        DragOver="OnWindowDragOver"
                                        ToolTip="{Binding Name}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <ui:MenuItem Header="添加新分类" Command="{Binding DataContext.AddCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Add24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="重命名 / 换图标" Command="{Binding RenameCommand}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Edit24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="添加子分组" Command="{Binding AddGroupCommand}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderAdd24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <Separator />
                                            <ui:MenuItem Header="删除分类" Command="{Binding DeleteCommand}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={x:Static conv:SymbolNameToSymbolRegularConverter.Instance}}" 
                                                       FontSize="20" HorizontalAlignment="Center" 
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="12" 
                                                   Margin="0,4,0,0" 
                                                   HorizontalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxWidth="84" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add Category Button -->
                    <ui:Button Grid.Row="1" 
                               Command="{Binding AddCategoryCommand}" 
                               HorizontalAlignment="Stretch" 
                               Appearance="Transparent"
                               Margin="4,8,4,4" 
                               ToolTip="添加新分类">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add20" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Text="加分类" FontSize="11.5" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Right Content Area: Groups & Items -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10,6,10,10"
                          AllowDrop="True"
                          Drop="OnWindowDrop"
                          DragOver="OnWindowDragOver">
                <StackPanel>
                    <!-- Groups in Selected Category -->
                    <ItemsControl ItemsSource="{Binding SelectedCategory.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutGroupViewModel}">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,10"
                                        AllowDrop="True"
                                        Drop="OnGroupDrop"
                                        DragOver="OnWindowDragOver">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <ui:MenuItem Header="添加快捷方式" Command="{Binding AddItemCommand}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Add24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="删除分组" Command="{Binding DeleteCommand}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <!-- Group Header -->
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                CornerRadius="7,7,0,0" 
                                                Padding="10,6"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnGroupHeaderClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="{Binding IsExpanded, Converter={x:Static conv:BooleanToChevronSymbolConverter.Instance}}" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Items.Count, StringFormat=' ({0})'}" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                               FontSize="11" 
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <ui:Button Appearance="Transparent" Padding="4" Margin="0,0,4,0" ToolTip="添加项目" Command="{Binding AddItemCommand}">
                                                        <ui:SymbolIcon Symbol="Add16" FontSize="12" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Group Items Grid -->
                                        <ItemsControl ItemsSource="{Binding Items}" 
                                                      Visibility="{Binding IsExpanded, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                                                      Margin="6,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShortcutItemViewModel}">
                                                    <ctrl:ShortcutTile DataContext="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty Group Hint when Expanded but has 0 items -->
                                        <Border Margin="12,12,12,16" HorizontalAlignment="Center"
                                                Visibility="{Binding Items.Count, Converter={x:Static conv:CountToVisibilityConverter.Instance}, ConverterParameter=Empty}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="拖动桌面快捷方式或文件至此处添加" 
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                           FontSize="11.5" 
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add New Group Button -->
                    <ui:Button Content="+ 添加新分组" 
                               Command="{Binding SelectedCategory.AddGroupCommand}"
                               HorizontalAlignment="Stretch"
                               Appearance="Transparent"
                               Margin="0,4,0,12" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
