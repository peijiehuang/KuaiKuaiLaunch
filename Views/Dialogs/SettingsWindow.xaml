<ui:FluentWindow x:Class="KuaiKuaiLaunch.Views.Dialogs.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:KuaiKuaiLaunch.ViewModels"
                 Title="软件设置"
                 Width="460" 
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="软件设置" ShowMaximize="False" ShowMinimize="False" Margin="-24,-12,-24,12" />

        <StackPanel Grid.Row="1">
            <!-- Edge Docking & Auto Hide -->
            <TextBlock Text="窗口与边缘停靠" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

            <ui:ToggleSwitch IsChecked="{Binding EnableEdgeDocking}" Content="启用屏幕边缘磁力吸附 (顶端/左右边缘)" Margin="0,0,0,8" />
            <ui:ToggleSwitch IsChecked="{Binding EnableEdgeAutoHide}" Content="停靠在屏幕边缘时鼠标移出自动滑出隐藏" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="移出自动隐藏延时 (毫秒)" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Minimum="100" Maximum="1000" Value="{Binding AutoHideDelayMs}" Width="120" SmallChange="50" LargeChange="100" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AutoHideDelayMs}" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,4,0,12" />

            <!-- System & Hotkey -->
            <TextBlock Text="系统与热键" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="全局唤醒/隐藏快捷键" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="1" Text="{Binding GlobalHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            </Grid>

            <ui:ToggleSwitch IsChecked="{Binding EnableMiddleClickWakeup}" Content="鼠标中键 (滚轮点击) 全局唤醒/隐藏主面板" Margin="0,0,0,8" />
            <ui:ToggleSwitch IsChecked="{Binding AutoStartWithWindows}" Content="开机自启动" Margin="0,0,0,8" />
            <ui:ToggleSwitch IsChecked="{Binding AlwaysOnTop}" Content="保持窗口置顶 (总在最前)" Margin="0,0,0,8" />
            <ui:ToggleSwitch IsChecked="{Binding KeepOpenAfterLaunch}" Content="点击启动项目后保持主窗口打开" Margin="0,0,0,14" />

            <Separator Margin="0,4,0,12" />

            <!-- Appearance -->
            <TextBlock Text="外观与尺寸" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="主题色彩" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="DisplayName" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="图标显示尺寸" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableIconSizes}" SelectedItem="{Binding SelectedIconSize}" DisplayMemberPath="DisplayName" />
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="保存并应用" Appearance="Primary" Command="{Binding SaveCommand}" MinWidth="90" Margin="0,0,8,0" />
            <ui:Button Content="取消" Command="{Binding CancelCommand}" MinWidth="80" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
